#include <iostream>
using namespace std;

struct node {
    int data;
    node* next;
};

struct linkedlist {
    node *head = nullptr;
    node *curr = nullptr;
    node *temp = nullptr;

    void addNode(int addData) {
        node *newnode = new node;
        newnode->data = addData;
        newnode->next = nullptr;

        if (head == nullptr) {
            head = newnode;
            temp = newnode->next;
        } else {
            curr = head;
            while (curr->next != nullptr) {
                curr = curr->next;
            }
            curr->next = newnode;
            newnode->next = nullptr;
        }
    }

    void printList() {
        curr = head;
        while (curr != nullptr) {
            cout << curr->data;
            cout << "->";
            curr = curr->next;
        }
        cout << "NullPtr";

    }

    void deleteNode(int val) {
        if (head == nullptr) {
            cout << "Empty list";
        }else {
            curr = head;
            temp = head;
            while (curr != nullptr && curr->data != val) {
                temp = curr;
                curr = curr->next;
            }
            if (curr == nullptr) {
                cout << "not found";
            }else {
                if (curr == head) {
                    head = curr->next;
                } else {
                    temp->next = curr->next;
                }

            }
            delete curr;

        }

    }

    void CreateThreeNodes(int val1, int val2, int val3) {
        addNode(val1);
        addNode(val2);
        addNode(val3);
        printList();
    }

    void ClearList() {
        curr = head;
        while (curr != nullptr) {
            temp = curr->next;
            delete curr;
            curr = temp;
        }
        head = nullptr;

    }

    int CountNodes() {
        curr = head;
        int count = 0;
        while (curr != nullptr) {
            count++;
            curr = curr->next;
        }
        return count;
    }

    void SearchNode(int target) {
        curr = head;
        int pos = 1;
        while (curr != nullptr && curr->data != target) {
            pos++;
            curr = curr->next;
        }
        if (curr == nullptr) {
            cout << "Value not found" << endl;
        } else {
            cout << "Node found at: " << pos << endl;
        }
    }

    void PrintSecondNode() {
        curr = head;
        curr = curr->next;

        if (curr != nullptr) {
            cout << "Second node value: " << curr->data << endl;
        } else {
            cout << "No second node" << endl;
        }
    }
};




int main() {
    int n, data;
    linkedlist *myList = new linkedlist;


    cout << "Enter n: ";
    cin >> n;
    for (int i = 0; i < n; i++) {
        cout << "Enter value to add: ";
        cin >> data;
        myList->addNode(data);

    }
    myList->SearchNode(20);
    myList->SearchNode(99);
    myList->PrintSecondNode();

}
