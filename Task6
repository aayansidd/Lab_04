#include <iostream>
using namespace std;

struct node {
    int data;
    node* next;
};

struct linkedlist {
    node *head = nullptr;
    node *curr = nullptr;
    node *temp = nullptr;

    void addNode(int addData) {
        node *newnode = new node;
        newnode->data = addData;
        newnode->next = nullptr;

        if (head == nullptr) {
            head = newnode;
            temp = newnode->next;
        } else {
            curr = head;
            while (curr->next != nullptr) {
                curr = curr->next;
            }
            curr->next = newnode;
            newnode->next = nullptr;
        }
    }

    void printList() {
        curr = head;
        while (curr != nullptr) {
            cout << curr->data;
            cout << "->";
            curr = curr->next;
        }
        cout << "NullPtr" << endl;

    }

    void deleteNode(int val) {
        if (head == nullptr) {
            cout << "Empty list";
        }else {
            curr = head;
            temp = head;
            while (curr != nullptr && curr->data != val) {
                temp = curr;
                curr = curr->next;
            }
            if (curr == nullptr) {
                cout << "not found";
            }else {
                if (curr == head) {
                    head = curr->next;
                } else {
                    temp->next = curr->next;
                }

            }
            delete curr;

        }

    }

    void CreateThreeNodes(int val1, int val2, int val3) {
        addNode(val1);
        addNode(val2);
        addNode(val3);
        printList();
    }

    void ClearList() {
        curr = head;
        while (curr != nullptr) {
            temp = curr->next;
            delete curr;
            curr = temp;
        }
        head = nullptr;

    }

    int CountNodes() {
        curr = head;
        int count = 0;
        while (curr != nullptr) {
            count++;
            curr = curr->next;
        }
        return count;
    }

    void SearchNode(int target) {
        curr = head;
        int pos = 1;
        while (curr != nullptr && curr->data != target) {
            pos++;
            curr = curr->next;
        }
        if (curr == nullptr) {
            cout << "Value not found" << endl;
        } else {
            cout << "Node found at: " << pos << endl;
        }
    }

    void PrintSecondNode() {
        curr = head;
        curr = curr->next;

        if (curr != nullptr) {
            cout << "Second node value: " << curr->data << endl;
        } else {
            cout << "No second node" << endl;
        }
    }

    void InsertAtBeginning(int addData) {
        node *n1 = new node;
        n1->data = addData;


        curr = head;
        n1->next = curr;
        head = n1;
    }

    void DeleteNode(int deleteval) {
        curr = head;
        temp = head;
        while (curr != nullptr && curr->data != deleteval) {
            temp = curr;
            curr = curr->next;
        }

        if (curr == nullptr) {
            cout << "List empty";
        } else if (curr->next != nullptr && curr->data == deleteval){
            temp->next = curr->next;
            delete curr;
        }else if (curr->data == deleteval){
            temp->next = nullptr;
            delete curr;
        }
    }
};




int main() {
    int n, data;
    linkedlist *myList = new linkedlist;
    int input = 0 , val;



    while (input != 7) {
        cout << "MENU" << endl;
        cout << "1. Insert at beginning" << endl;
        cout << "2. Insert at the end" << endl;
        cout << "3. Search by value" << endl;
        cout << "4. Delete by value" << endl;
        cout << "5. Display all nodes" << endl;
        cout << "6. Display Second Node" << endl;
        cout << "7. Exit";
        cin >> input;

        switch(input) {
            case 1:
                cout << "What value to insert: ";
                cin >> val;
                myList->InsertAtBeginning(val);
                break;
            case 2:
                cout << "Value to add in the end: ";
                cin >> val;
                myList->addNode(val);
                break;
            case 3:
                cout << "Value to search: ";
                cin >> val;
                myList->SearchNode(val);
                break;
            case 4:
                cout << "Value to delete: ";
                cin >> val;
                myList->DeleteNode(val);
                break;
            case 5:
                myList->printList();
                break;
            case 6:
                myList->PrintSecondNode();
                break;
            case 7:
                cout << "Exiting...";
                break;
            default:
                cout << "Exiting...";
                break;
        }
    }

}
